// yaml-language-server: $schema=
// tsconfig.app.json -> for browser/react
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022", // js version to emit
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], // type definitions available - DOM = browser API's
    "module": "ESNext", // Module system
    "skipLibCheck": true,
    "types": [],
    "experimentalDecorators": true,

    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@stores/*": ["./src/stores/*"],
      "@services/*": ["./src/services/*"],
      "@components/*": ["./src/components/*"],
      "@routes/*": ["./src/components/routes/*"],
      "@features/*": ["./src/features/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler", // how imports are resolved -> use bundler for vite
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "jsx": "react-jsx",

    // output
    "noEmit": true, // don't output files, let vite handle it

    /* Linting */
    // strict option - keeps strict type checking on, enables strictNullChecks, noImplicitAny
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },

  "include": ["src"] // where to link/check files
}
