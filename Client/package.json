{
  "name": "h-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev": "vite",
    "generate-types": "openapi-typescript https://localhost:8000/openapi.json -o ./src/types/api.ts",
    "dev:with-types": "concurrently \"npm run generate-types\" \"npm run dev\"",
    "generate-types:docker": "NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript https://server:8000/openapi.json -o ./src/types/api.ts",
    "dev:with-types:docker": "concurrently \"npm run generate-types:docker\" \"npm run dev -- --host\""
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "axios": "^1.13.2",
    "jwt-decode": "^4.0.0",
    "luxon": "^3.7.2",
    "motion": "^12.23.26",
    "openapi-typescript": "^7.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.9.6",
    "streamdown": "^2.5.0",
    "tailwindcss": "4.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/js": "^9.33.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/chance": "^1.1.7",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "chance": "^1.1.13",
    "concurrently": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.555.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/affable1920/h-app"
  },
  "author": {
    "email": "affableshamik98@gmail.com",
    "name": "Shamik Zaffar"
  }
}
